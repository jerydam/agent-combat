# Backend config for BOT Chain MAINNET (chain id 677).
#
# The real .env is gitignored, so a `git push` never updates the deployed
# backend — these values must also be set in the Koyeb service env vars.
# This file is the checklist of what has to be set there.

DATABASE_URL=postgresql://USER:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

RPC_URL=https://rpc.botchain.ai
CHAIN_ID=677

# Deploy.s.sol run on chain 677 — see contracts/broadcast/Deploy.s.sol/677/
AGENT_NFT_ADDRESS=0xd6Fb93BA987cE1C18f14aAC7A019a21d139F9E03
BATTLE_ARENA_ADDRESS=0x8ee9C3AFc991C829271DfE8Af192187301fEc8cc
SOLO_ARENA_ADDRESS=0x21c6308D1188978a20619D4d15C267090733DAA9
LEAGUE_ADDRESS=0x59BD26ECf86BE6B4a3A12c360b922DeEe466df78
TOURNAMENT_ADDRESS=0x4a6610E933d4a704559a4A1D4C6d12A65F4B3D42
MARKETPLACE_ADDRESS=0x454366b3E976e919eFe4439AD31951b181a35c17
SHOP_ADDRESS=0x7852eC515D6560c0806019e639bc64e294F93c76
BOT_OWNER_ADDRESS=0x9F2B0118CedB3d24748448D6D091a31F163c121e

# Block AgentNFT was deployed on 677. The log scanner starts here; leaving
# a previous deployment's block in place makes every backfill scan
# thousands of empty ranges.
DEPLOY_BLOCK=18602544

# Secrets — never commit the real values.
OWNER_PRIVATE_KEY=0x...
GAME_SERVER_PRIVATE_KEY=0x...
GAME_SERVER_ADDRESS=0x...

POLL_INTERVAL_SECONDS=2
CORS_ORIGINS=https://www.agentcombat.xyz
