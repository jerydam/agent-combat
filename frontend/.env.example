# Frontend config for BOT Chain MAINNET (chain id 677).
#
# The real .env is gitignored, so a `git push` never updates the deployed
# site — these must also be set in the Vercel project env vars. NEXT_PUBLIC_*
# is inlined at BUILD time, so changing them requires a new build, not a
# redeploy of the existing one.

NEXT_PUBLIC_API_URL=https://scary-justina-faucetdrops-260a45e5.koyeb.app
NEXT_PUBLIC_WALLET_API=https://thoughtful-carmencita-faucetdrops-02a54589.koyeb.app

NEXT_PUBLIC_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_CHAIN_ID=677

# Deploy.s.sol run on chain 677 — see contracts/broadcast/Deploy.s.sol/677/
NEXT_PUBLIC_AGENT_NFT=0xd6Fb93BA987cE1C18f14aAC7A019a21d139F9E03
